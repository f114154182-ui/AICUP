from ultralytics import YOLO

model = YOLO('yolo11s.pt') #初次訓練使用YOLO官方的預訓練模型，如要使用自己的模型訓練可以將'yolo12n.pt'替換掉
results = model.train(data="./aortic_valve_colab.yaml",
            epochs=50,
            batch=8,
            imgsz=640,
            patience=10,
            device=0 #使用GPU進行訓練
            )
